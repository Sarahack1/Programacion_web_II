<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sigila</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Practica02FincaMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sigila</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                   <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>

                            @if (User.IsInRole("administradora"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Administracion">Administración</a>
                                </li>
                            }

                            @if (User.IsInRole("administradora") || User.IsInRole("usuaria_final"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Alertas">Alertas y Monitoreo</a>
                                </li>
                            }

                            <!-- NUESTRO NUEVO CRUD DE SIGILA -->
                            <li class="nav-item">
                                <a class="nav-link text-dark " asp-area="" asp-controller="Contactos" asp-action="Index">
                                    <i class="bi bi-shield-heart text-danger"></i> Red de Apoyo
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="small text-muted">
                        <!-- Mostramos el nombre completo y el rol extraído de los Claims -->
                        @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                    </span>
                   <form id="logoutForm" asp-controller="Cuenta" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger btn-sm" type="submit">
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SIGILA - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/idle-timeout.js" asp-append-version="true"></script>
    }
</body>
</html>
