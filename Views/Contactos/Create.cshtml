@model Practica02MVC.Models.ContactoEmergencia
@{
    ViewData["Title"] = "Nuevo Contacto";
}

<h1 style="color: #880e4f; font-weight: bold;">Agregar Contacto a la Red</h1>
<hr />

<form asp-action="Create" method="post" class="row g-3 shadow-sm p-4 rounded bg-white">
    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold"></div>

    <div class="col-md-6">
        <label asp-for="IdUsuarioPropietario" class="form-label fw-bold"></label>
        <select asp-for="IdUsuarioPropietario" asp-items="ViewBag.Usuarias" class="form-select border-danger">
            <option value="">Seleccione a la usuaria dueña...</option>
        </select>
        <span asp-validation-for="IdUsuarioPropietario" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NombreContacto" class="form-label fw-bold"></label>
        <input asp-for="NombreContacto" class="form-control border-danger" placeholder="Ej. María López" />
        <span asp-validation-for="NombreContacto" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Telefono" class="form-label fw-bold"></label>
        <input asp-for="Telefono" class="form-control border-danger" placeholder="Ej. +505 8888-8888" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Parentesco" class="form-label fw-bold"></label>
        <input asp-for="Parentesco" class="form-control border-danger" placeholder="Ej. Madre, Hermana, Amigo" />
        <span asp-validation-for="Parentesco" class="text-danger"></span>
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn text-white fw-bold" style="background-color: #d81b60;">Guardar Contacto</button>
        <a asp-action="Index" class="btn btn-secondary fw-bold">Cancelar</a>
    </div>
</form>

<!-- El manual exige esto para activar la validación en vivo del lado del cliente -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}