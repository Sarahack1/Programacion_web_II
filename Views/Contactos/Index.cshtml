@model IEnumerable<Practica02MVC.Models.ContactoEmergencia>
@{
    ViewData["Title"] = "Contactos de Emergencia";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 style="color: #9641ae; font-weight: bold;">Red de Apoyo</h1>
        <p class="text-muted mb-0">Gestión de contactos de emergencia del sistema Sigila.</p>
    </div>
    
    <!-- EL BOTÓN ESTÁ AQUÍ MISMO -->
    @if (User.IsInRole("administradora") || User.IsInRole("usuaria_final"))
    {
        <a asp-action="Create" class="btn text-white fw-bold" style="background-color: #d81b60;">Nuevo contacto</a>
    }
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success fw-bold">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Usuaria Dueña</th>
                <th>Nombre del Contacto</th>
                <th>Teléfono</th>
                <th>Parentesco</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.NombrePropietario</td>
                    <td>@item.NombreContacto</td>
                    <td>@item.Telefono</td>
                    <td><span class="badge bg-secondary">@item.Parentesco</span></td>
                    <td class="text-center text-nowrap">
                        
                        <!-- Detalles: Todos pueden ver -->
                        <a asp-action="Details" asp-route-id="@item.IdContacto" class="btn btn-sm btn-outline-dark">Ver</a>
                        
                        <!-- EDITAR: visible para administradora y usuaria_final -->
                        @if (User.IsInRole("administradora") || User.IsInRole("usuaria_final"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.IdContacto" class="btn btn-sm btn-outline-primary">Editar</a>
                        }
                        
                        <!-- ELIMINAR: visible solo para administradora -->
                        @if (User.IsInRole("administradora"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.IdContacto" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>